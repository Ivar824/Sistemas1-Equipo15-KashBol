# =====================================================================
# VARIABLES DE ENTORNO DE SUPABASE (PLANTILLA)
# =====================================================================
# Copia este archivo como '.env' en la raíz y coloca tus credenciales:
#
# VITE_SUPABASE_URL: URL de tu proyecto en Supabase (ej: https://xyzcompany.supabase.co)
# VITE_SUPABASE_ANON_KEY: Clave pública 'anon' encontrada en Project Settings > API

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-de-supabase
